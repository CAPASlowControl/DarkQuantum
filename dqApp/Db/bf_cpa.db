# Pressures
record (ai, "$(P):Plow"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.low_pressure, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"Bar")

    field(LOLO,"2.8")
    field(LLSV,"MAJOR")
    field(LOW,"3.4")
    field(LSV,"MINOR")
    field(HIHI,"17.2")
    field(HHSV,"MAJOR")
    field(HIGH,"16.5")
    field(HSV,"MINOR")
}


record (ai, "$(P):Phigh"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.high_pressure, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"Bar")

    field(LOLO,"10.3")
    field(LLSV,"MAJOR")
    field(LOW,"11.7")
    field(LSV,"MINOR")
    field(HIHI,"27.6")
    field(HHSV,"MAJOR")
    field(HIGH,"25.9")
    field(HSV,"MINOR")
}

#Status

record (ai, "$(P):compressor_running_status"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.compressor_running_status, %f) $(PORT)")
}

record (ai, "$(P):operating_state"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.operating_state, %f) $(PORT)")
}



# Alarms
record (ai, "$(P):warning_state"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.warning_state, %f) $(PORT)")
 
    field(HIHI,"1")
    field(HHSV,"MAJOR")
}

