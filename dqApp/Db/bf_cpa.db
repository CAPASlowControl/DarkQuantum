# Compressor

# Temperatures
record (bo, "$(P):read"){#Compressor
    field( SCAN, "10 second")
    field (DTYP, "stream")
    field (OUT,  "@bf.proto getPage(/values/driver.cpa/?fields=latest_value) $(PORT)")
}

record (ai, "$(P):TcoolIn"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.coolant_in_temperature, %f) $(PORT)")
    field(PREC,2)
    field(AOFF,"-273.15")
    field(EGU,"ºC")

    field(LOLO,"4")
    field(LLSV,"MAJOR")
    field(LOW,"7")
    field(LSV,"MINOR")
    field(HIHI,"43")
    field(HHSV,"MAJOR")
    field(HIGH,"29")
    field(HSV,"MINOR")
}

record (ai, "$(P):TcoolOut"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.coolant_out_temperature, %f) $(PORT)")
    field(PREC,2)
    field(AOFF,"-273.15")
    field(EGU,"ºC")

    field(LOLO,"4")
    field(LLSV,"MAJOR")
    field(LOW,"7")
    field(LSV,"MINOR")
    field(HIHI,"52")
    field(HHSV,"MAJOR")
    field(HIGH,"43")
    field(HSV,"MINOR")
}

