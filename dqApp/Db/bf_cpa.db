# Pressures
record (ai, "$(P):Plow"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.low_pressure, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"Bar")

    field(LOLO,"2.8")
    field(LLSV,"MAJOR")
    field(LOW,"3.4")
    field(LSV,"MINOR")
    field(HIHI,"17.2")
    field(HHSV,"MAJOR")
    field(HIGH,"16.5")
    field(HSV,"MINOR")
}


