# Compressor

record (bo, "$(P):read"){#Compressor
    field( SCAN, "10 second")
    field (DTYP, "stream")
    field (OUT,  "@bf.proto getPage(/values/driver.cpa/?fields=latest_value) $(PORT)")
}

record (ai, "$(P):TcoolIn"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.coolant_in_temperature, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"K")
}

record (ai, "$(P):TcoolOut"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.coolant_out_temperature, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"K")
}

record (ai, "$(P):TOil"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.cpa.oil_temperature, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"K")
