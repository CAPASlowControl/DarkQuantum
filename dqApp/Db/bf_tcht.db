# OnOff
record (bi, "$(P):ht1_active"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.bftc.data.heaters.heater_1.active, %b) $(PORT)")
    field(ZNAM,"Off")
    field(ONAM,"On")
}

record (bi, "$(P):ht1_relay"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.bftc.data.heaters.heater_1.relay_status, %b) $(PORT)")
    field(ZNAM,"On")
    field(ONAM,"Off")
}


