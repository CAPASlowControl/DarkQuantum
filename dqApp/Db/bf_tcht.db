# BFTC Heaters

record (bi, "$(P):read"){ 
    field( SCAN, "10 second")
    field (DTYP, "stream")
    field (INP,  "@bf.proto getPage(/values/driver.bftc/data/heaters/?fields=latest_value) $(PORT)")
}

# Power
record (ai, "$(P):ht1_pw"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.bftc.data.heaters.heater_1.power, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"W")
}

record (ai, "$(P):ht2_pw"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.bftc.data.heaters.heater_2.power, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"W")
}

