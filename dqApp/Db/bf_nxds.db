
# NXDS
record (bo, "$(P):read"){
    field( SCAN, "10 second")
    field (DTYP, "stream")
    field (OUT,  "@bf.proto getPage(/values/driver.nxds/?fields=latest_value) $(PORT)")
}

record (ai, "$(P):pump_design_frequency"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.nxds.pump_design_frequency, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"Hz")
}


record (ai, "$(P):rotational_frequency"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.nxds.rotational_frequency, %f) $(PORT)")
    field(PREC,2)
    field(EGU,"Hz")
}

record (ai, "$(P):pump_temperature"){
    field( SCAN, "I/O Intr")
    field (DTYP, "stream")
    field (INP,  "@bf.proto processPage(driver.nxds.pump_temperature, %f) $(PORT)")
    field(PREC,2)
    field(AOFF,"-273.15")
    field(EGU,"ºC")
}

