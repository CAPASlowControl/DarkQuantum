# Read Page
record (bo, "$(P):read"){
    field( SCAN, "10 second")
    field (DTYP, "stream")
    field (OUT,  "@bf.proto getPage(/values/mapper/bf/?fields=latest_value) $(PORT)")
}

# Pressures
record (ai, "$(P):p1"){
    field( SCAN, "I/O Intr")
    #field( SCAN, "1 second")
    field (DTYP, "stream")
    #field (INP,  "@bf.proto testPage(/values/mapper/bf/?fields=latest_value, mapper\.bf\.pressures\.p1, %f) $(PORT)")
    field (INP,  "@bf.proto processPage(mapper\.bf\.pressures\.p1, %f) $(PORT)")
    field( EGU, "Bar")
    field(PREC,2)
}

