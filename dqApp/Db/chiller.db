# ./testApp/Db/test.db
# PROBES
record(ai, "$(P):Tout") { 
    field(DESC, "Tank Water Temp. Out")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlPr_256 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(HIHI,40) 
    field(HIGH,35)
    field(LOLO,4.5)
    field(LOW,6)
    field(HHSV,"MAJOR")
    field(HSV,"MINOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}

record(ai, "$(P):Tevap") {
    field(DESC, "Evap. Water Temp. Out ")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlPr_256 2 1)MODBUS_DATA") 
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(HIHI,40)
    field(HIGH,35)
    field(LOLO,4.5)
    field(LOW,6)
    field(HHSV,"MAJOR")
    field(HSV,"MINOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}

record(ai, "$(P):Pref_hp") {
    field(DESC, "Refrigerant Circuit High Pressure")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlPr_256 4 1)MODBUS_DATA") 
    field(PREC,1)
    field(ASLO,0.1) # Int to Pres
    field(EGU,"Bar") 
    field(PINI,"NO")
    field(HIHI,38.5) # Al09 value: 38.8
    field(HIGH,37.5) # 
    field(LOLO,5)  # 
    field(HHSV,"MAJOR")
    field(LLSV,"MAJOR")
}

record(acalcout, "$(P):Pref_hp_MaxCalc") {
    field(DESC, "Ref. Circuit HP. Calc")
    field(INPA,"$(P):Pref_hp") 
    field(INAA,"$(P):Pref_hp_MaxCalc.AA") 

    field(CALC,"AA:=CAT(AA[1,3599],A);AMAX(AA)")
    field(SCAN,"1 second")
    field(NELM,3600) # 1 hour

    field(PREC,1)
    field(EGU,"Bar") 
    field(PINI,"NO")

    field(HIHI,38.5) # Al09 value: 38.8
    field(HIGH,37.5) # 
    field(LOLO,5)  # 
    field(HHSV,"MAJOR")
    field(LLSV,"MAJOR")
}

# EXPANSION VALVE PROBES

record(ai, "$(P):TexpV") {
    field(DESC, "Exp. Valve Temp")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlExpVPr_288 0 1)MODBUS_DATA") 
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(HIHI,40)
    field(HIGH,35)
    field(LOLO,5)
    field(LOW,10)
    field(HHSV,"MAJOR")
    field(HSV,"MINOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}

record(ai, "$(P):Pref_lp") {
    field(DESC, "Refrigerant Circuit Low Pressure")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlExpVPr_288 4 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"Bar") 
    field(PINI,"NO")
    field(HIHI,30)
    field(LOW,3.5) # Al02 Value is 2
    field(LOLO,2.5) # Al02 Value is 2
    field(HHSV,"MAJOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}


# Machine Status

record(mbbiDirect, "$(P):MachineStatus") {
    field(DESC, "Machine Status")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynUInt32Digital")
    field(INP,"@asynMask(read_ChlMachineStatus_1280 0 0xFFFF 1)MODBUS_DATA") #  field(INP,"@asynMask(portName,offset,mask,timeout)drvUser")
    field(FLNK,"$(P):MachineStatus_Standby")
    field(PINI,"NO")
}

record(bi, "$(P):MachineStatus_Standby") {
    field(DESC, "Machine Status")
    field(SCAN, "Passive")
    field(INP,"$(P):MachineStatus.B0 MSI")
    field(ZNAM,"Standby")
    field(ONAM,"On")
    field(PINI,"NO")
    field(ZSV,"MINOR")
    field(OSV,"NO_ALARM")
}


record(longout, "$(P):MachineStatusSet") {
    field(DESC, "Machine Status")
    #field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    #field(OUT,"@asynMask(write_ChlMachineStatus_1280 0 0xFFFF 1)MODBUS_DATA") #  field(INP,"@asynMask(portName,offset,mask,timeout)drvUser")
    field(OUT,"@asyn(write_ChlMachineStatus_1280 0 1)MODBUS_DATA") #  field(INP,"@asynMask(portName,offset,mask,timeout)drvUser")
    field(PINI,"NO")
}

