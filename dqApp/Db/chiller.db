# SetPoint
record(ai, "$(P):ChSetPointRB") {
    field(DESC, "Chiller Set Point")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlSetPoint_768 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(HIHI,"30")
    field(HIGH,"23")
    field(LOLO,"5")
    field(LOW,"8")
    field(HHSV,"MAJOR")
    field(LLSV,"MAJOR")
    field(HSV,"MINOR")
    field(LSV,"MINOR")
}

record(ao, "$(P):ChSetPoint") {
    field(DESC, "Chiller Set Point")
    #field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(OUT,"@asyn(write_ChlSetPoint_768 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(VAL,20)
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(DRVL,"7")
    field(DRVH,"25")
}

