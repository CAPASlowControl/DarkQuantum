# ./testApp/Db/test.db
# PROBES
record(ai, "$(P):Tout") { 
    field(DESC, "Tank Water Temp. Out")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlPr_256 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(HIHI,40) 
    field(HIGH,35)
    field(LOLO,5)
    field(LOW,10)
    field(HHSV,"MAJOR")
    field(HSV,"MINOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}

record(ai, "$(P):Tevap") {
    field(DESC, "Evap. Water Temp. Out ")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlPr_256 2 1)MODBUS_DATA") 
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(HIHI,40)
    field(HIGH,35)
    field(LOLO,5)
    field(LOW,10)
    field(HHSV,"MAJOR")
    field(HSV,"MINOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}

record(ai, "$(P):Pref_hp") {
    field(DESC, "Refrigerant Circuit High Pressure")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlPr_256 4 1)MODBUS_DATA") 
    field(PREC,1)
    field(ASLO,0.1) # Int to Pres
    field(EGU,"Bar") 
    field(PINI,"NO")
    field(HIHI,50) # Al09 value
    field(LOLO,5)  # 
    field(HHSV,"MAJOR")
    field(LLSV,"MAJOR")
}

# EXPANSION VALVE PROBES

record(ai, "$(P):TexpV") {
    field(DESC, "Exp. Valve Temp")
    field(SCAN, "I/O Intr")
