# Working Hours
record(longin, "$(P):CompWH") {
    field(DESC, "Compressor Working Hours")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlCompWH_3584 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(EGU,"h")
    field(PINI,"NO")
}

record(longin, "$(P):WaterPumpWH") {
    field(DESC, "Water Pump Working Hours")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlEvapWH_3590 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(EGU,"h")
    field(PINI,"NO")
}

# Time PV
record(stringin, "$(P):time") {
  field(SCAN,"1 second")
  field(DTYP, "Soft Timestamp")
  #field(TSEL, "${P}.Tout CP") #Any PV 
  field(INP, "@%b %d %Y %H:%M:%S")
}

record(stringin, "$(P):currentHourStr") {
  field(SCAN,"1 second")
  field(DTYP, "Soft Timestamp")
  #field(TSEL, "${P}.Tout CP") #Any PV 
  field(INP, "@%H")
  field(FLNK,"$(P):currentHour")
}

record(longin, "$(P):currentHour") {
  field(SCAN,"Passive")
  field(INP, "$(P):currentHourStr")
  field(EGU,"h")
}

record(longout, "$(P):Auto_h1") {
  field(VAL,"12")
  field(EGU,"h")
  field(DRVL,"0")
  field(DRVH,"24")
}

record(longout, "$(P):Auto_h2") {
  field(VAL,"22")
  field(EGU,"h")
  field(DRVL,"0")
  field(DRVH,"24")
}

record(ao, "$(P):Auto_SP1") {
    field(DESC, "Auto Set Point1")
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(VAL,12)
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(DRVL,"7")
    field(DRVH,"25")
}

record(ao, "$(P):Auto_SP2") {
    field(DESC, "Auto Set Point1")
    field(PREC,1)
    field(VAL,15)
    field(EGU,"ºC") 
    field(PINI,"NO")
    field(DRVL,"7")
    field(DRVH,"25")
}

record(calcout, "$(P):Auto_Calc"){
    field(INPA,"$(P):currentHour CP") # Process PV when this value changes
    field(INPB,"$(P):Auto_h1")
    field(INPC,"$(P):Auto_h2")
    field(INPD,"$(P):Auto_SP1")
    field(INPE,"$(P):Auto_SP2")

    field(CALC,"( (A>=B) && (A<C) )?D:E ")

    field(EGU,"ºC") 
    field(PREC,1)
    
    field(OUT,"$(P):ChSetPoint PP") # PP change value and process PV sending message to device.
    #field(OOPT,"On Change")
    field(DOPT,"Use CALC")

    field(VAL,15) #Initial value before processing
    field(DISA,1) # Enable=0; Disable=1 proccesing of the PV.
}

# Test
record(ao, "$(P):alarmTest") { 
    field(DESC, "Test PV")
    field(PREC,0)
    field(PINI,"YES")
    field(HIHI,100) 
    field(HIGH,90)
    field(VAL,50)
    field(LOLO,0)
    field(LOW,10)
    field(HHSV,"MAJOR")
    field(HSV,"MINOR")
    field(LLSV,"MAJOR")
    field(LSV,"MINOR")
}
