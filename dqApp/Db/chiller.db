    field(DESC, "Heat Pump Set Point")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlSetPoint_768 3 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,2)
