# Working Hours
record(ai, "$(P):CompWH") {
    field(DESC, "Compressor Working Hours")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlCompWH_3584 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,0)
    field(ASLO,10) 
    field(EGU,"h")
    field(PINI,"NO")
}

record(ai, "$(P):EvapWH") {
    field(DESC, "Evaporator/Fan Working Hours")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlEvapWH_3590 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,0)
    field(ASLO,10)
    field(EGU,"h")
    field(PINI,"NO")
}



