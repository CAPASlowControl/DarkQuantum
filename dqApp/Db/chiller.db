# SetPoint
record(ai, "$(P):ChSetPointRB") {
    field(DESC, "Chiller Set Point")
    field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(INP,"@asyn(read_ChlSetPoint_768 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,1)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"NO")
}

record(ao, "$(P):ChSetPoint") {
    field(DESC, "Chiller Set Point")
    #field(SCAN, "I/O Intr")
    field(DTYP,"asynInt32")
    field(OUT,"@asyn(write_ChlSetPoint_768 0 1)MODBUS_DATA") # @asyn(port offset timeout)drvUser
    field(PREC,0)
    field(ASLO,0.1) # Int to Temp.
    field(EGU,"ºC") 
    field(PINI,"YES")
    field(DRVL,"5")
    field(DRVH,"30")
}



