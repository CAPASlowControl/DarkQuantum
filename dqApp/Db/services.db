record(mbbi,"$(P):Archiver"){
	field(DESC,"Archiver Service Status")
	field(DTYP,"stream")
	#field(VAL,"systemctl is-active archiverrdb")
	field(INP,'@services.proto command(systemctl is-active archiverrdb) terminal')
	field(SCAN,"5 second")

	field(ZRVL,0)
	field(ONVL,1)
	field(TWVL,2)
	field(ZRST,"active")
	field(ONST,"inactive")
	field(TWST,"failed")
	field(ONSV,"MINOR")
	field(TWSV,"MINOR")
}

