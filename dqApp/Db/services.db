record(mbbi,"$(P):BFIOC"){
	field(DESC,"Service Status")
	field(DTYP,"stream")
	field(INP,'@services.proto commandSSH(sshpass -ppassword ssh user@192.168.100.104 -t \"systemctl is-active bfioc\") terminal')
	field(SCAN,"5 second")

	field(ZRVL,0)
	field(ONVL,1)
	field(TWVL,2)
	field(ZRST,"active")
	field(ONST,"inactive")
	field(TWST,"failed")
	field(ONSV,"MINOR")
