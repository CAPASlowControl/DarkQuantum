    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions>
        <action type="command">
          <description>Execute Command</description>
          <command>gnome-terminal -- telnet localhost 4611</command>
        </action>
      </actions>
      <text>telnet localhost 4611</text>
      <x>145</x>
      <y>10</y>
      <width>180</width>
      <height>20</height>
      <tooltip>$(actions)</tooltip>
    </widget>
