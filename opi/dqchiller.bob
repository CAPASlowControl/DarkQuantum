      <x>80</x>
      <y>160</y>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_33</name>
      <text>Current Hour</text>
      <y>30</y>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_12</name>
      <pv_name>$(P):currentHourStr</pv_name>
      <x>80</x>
      <y>30</y>
      <width>112</width>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_2</name>
      <pv_name>$(P):Auto_h1</pv_name>
      <x>80</x>
      <y>60</y>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_34</name>
      <text>Hour 1</text>
      <y>60</y>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_35</name>
      <text>Hour 2</text>
      <y>80</y>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_3</name>
