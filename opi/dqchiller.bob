  <widget type="group" version="3.0.0">
    <name>AutoSetPoint</name>
    <y>316</y>
    <width>236</width>
    <height>249</height>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <transparent>true</transparent>
    <tooltip>The AutoSetPoint sets automatically the Chiller Temperature.

SP1: (currentHour&gt;=h1) and (currentHour&lt;h2) 
SP2: (currentHour&lt;h1) and (currentHour&gt;=h2)</tooltip>
    <widget type="label" version="2.0.0">
      <name>Label_31</name>
      <text>Auto SP</text>
      <y>160</y>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_32</name>
      <text>Time</text>
      <y>10</y>
    </widget>
    <widget type="textupdate" version="2.0.0">
